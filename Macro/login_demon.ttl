	;
	pause 1
		
	sendln 'echo "TEST_MCU TEST_RS485" > /usrdata/askey/sfifo'
	
	pause 1
	
	sendln 'ping 8.8.8.8 &'
	pause 1
	
	sendln 'cat /dev/smd7'
	
loop











